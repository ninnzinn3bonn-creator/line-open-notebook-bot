# Copy to .env. Never commit the real file.
OPEN_NOTEBOOK_VERSION=1.14.0
OPEN_NOTEBOOK_IMAGE=lfnovo/open_notebook:1.14.0@sha256:e53f90d6153fcf4a64604d9a0c12cb0428a32cfb8dbcbb72e81ab12c013ee330
SURREALDB_IMAGE=surrealdb/surrealdb:v2@sha256:d653f6c8a89e81f865ee31cd2f587c50f50ace922175e04150b1e385d2f86011
OPEN_NOTEBOOK_BASE_URL=http://localhost:5055
OPEN_NOTEBOOK_ENCRYPTION_KEY=replace-with-at-least-16-random-characters
OPEN_NOTEBOOK_PASSWORD=replace-with-a-strong-admin-password
SURREAL_USER=root
SURREAL_PASSWORD=replace-local-password
BRIDGE_PORT=3001
ANSWER_PROVIDER=mock
# Required when ANSWER_PROVIDER=open-notebook. Use Open Notebook record IDs, not public model names.
OPEN_NOTEBOOK_STRATEGY_MODEL_ID=
OPEN_NOTEBOOK_ANSWER_MODEL_ID=
OPEN_NOTEBOOK_FINAL_MODEL_ID=
GROUNDING_ANSWER_THRESHOLD=0.70
GROUNDING_OUT_OF_SCOPE_THRESHOLD=0.60
OUT_OF_SCOPE_ANSWER_TEXT=恐れ入りますが、こちらでは店舗に関するお問い合わせを承っています。店舗について確認したいことがございましたら、内容をお聞かせください。
REVIEW_PENDING_ANSWER_TEXT=お問い合わせありがとうございます。恐れ入りますが、そちらの内容は現在このLINEではご案内できません。店舗に関するほかのご質問がございましたら、お尋ねください。
HUMAN_HANDOFF_ANSWER_TEXT=お問い合わせありがとうございます。担当者による確認が必要な内容です。恐れ入りますが、店舗へ直接お問い合わせください。
HUMAN_HANDOFF_PHONE=
HUMAN_HANDOFF_HOURS=
HUMAN_HANDOFF_CHAT_URL=
INTERNAL_ADMIN_TOKEN=replace-with-a-long-random-admin-token
CONVERSATION_MAX_RALLIES=3
MOCK_ANSWER_DELAY_MS=10
WORKER_CONCURRENCY=2
MAX_RETRIES=2
AI_TIMEOUT_MS=30000
WORKER_POLL_MS=250
WORKER_LEASE_MS=120000
RETRY_DELAY_MS=2000
LINE_REPLY_CUTOFF_MS=45000
LINE_SEND_TIMEOUT_MS=10000
# Format: label::message text, separated by |. Up to 13 LINE quick-reply items.
LINE_QUICK_REPLIES=営業時間::営業時間を教えてください|アクセス::お店へのアクセスを教えてください|予約について::予約について教えてください|担当者に相談::担当者に相談したいです
EMERGENCY_ANSWER_TEXT=申し訳ございません。ただいま回答を取得できませんでした。お急ぎの場合は店舗へ直接お問い合わせいただくか、時間をおいてもう一度お試しください。
SQLITE_PATH=./data/queue.db

# Production hostname managed by Cloudflare, without https:// or a path.
PUBLIC_HOST=notebook.example.com
# Separate Cloudflare Access-protected hostname for the Open Notebook UI.
OPEN_NOTEBOOK_ADMIN_HOST=admin-notebook.example.com
# Dedicated Cloudflare resource namespace. Do not reuse an existing project tunnel or Access app.
CLOUDFLARE_PROJECT_SLUG=line-open-notebook-poc
CLOUDFLARE_TUNNEL_NAME=line-open-notebook-poc-oci
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.9.1@sha256:b269e8abd07a5bf6f3f4be65d5050b2174eca89c56a0241a8ff32a16aec454e4
CADDY_IMAGE=caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
# Path to a chmod 600 file outside Git containing only the remotely-managed tunnel token.
CLOUDFLARE_TUNNEL_TOKEN_FILE=./secrets/cloudflare-tunnel-token

# Configure provider credentials in the Open Notebook UI.
# Do not add API keys here unless the chosen deployment procedure requires it.
GEMINI_EVALUATION_MODEL=

# LINE values are required only for real E2E testing.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Temporary tunnel URL for local E2E, or omit this and set PUBLIC_HOST for OCI/VPS E2E.
LINE_WEBHOOK_BASE_URL=
