# Copy to .env. Never commit the real file.
OPEN_NOTEBOOK_VERSION=1.14.0
OPEN_NOTEBOOK_BASE_URL=http://localhost:5055
OPEN_NOTEBOOK_ENCRYPTION_KEY=replace-with-at-least-16-random-characters
SURREAL_USER=root
SURREAL_PASSWORD=replace-local-password
BRIDGE_PORT=3001
ANSWER_PROVIDER=mock
MOCK_ANSWER_DELAY_MS=10
WORKER_CONCURRENCY=2
MAX_RETRIES=2
AI_TIMEOUT_MS=30000

# Configure provider credentials in the Open Notebook UI.
# Do not add API keys here unless the chosen deployment procedure requires it.
GEMINI_EVALUATION_MODEL=

# LINE values are required only for real E2E testing.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

