:8080 {
	@line_webhook {
		path /webhooks/line
		method POST
	}
	handle @line_webhook {
		request_body {
			max_size 1MB
		}
		reverse_proxy bridge:3001
	}

	@health {
		path /health
		method GET HEAD
	}
	handle @health {
		reverse_proxy bridge:3001
	}

	handle {
		respond "Not Found" 404
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cache-Control "no-store"
		-Server
	}
}
