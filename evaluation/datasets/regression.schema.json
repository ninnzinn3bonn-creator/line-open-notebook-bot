{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["revision", "timezone", "cases"],
  "additionalProperties": false,
  "properties": {
    "revision": { "type": "string", "minLength": 1 },
    "timezone": { "const": "Asia/Tokyo" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "question", "expectedFacts", "forbiddenFacts", "shouldAnswer", "severity"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "expectedFacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "expectedAnyOf": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "forbiddenFacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "shouldAnswer": { "type": "boolean" },
          "severity": { "enum": ["normal", "important", "critical"] },
          "referenceTime": { "type": "string", "format": "date-time" },
          "setupMessages": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "expectedRoutes": { "type": "array", "minItems": 1, "items": { "enum": ["in_scope", "out_of_scope", "needs_review", "deterministic"] } },
          "sourceRequired": { "type": "boolean" },
          "maxSentences": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
