{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["revision", "timezone", "cases"],
  "additionalProperties": false,
  "properties": {
    "revision": { "type": "string", "minLength": 1 },
    "timezone": { "const": "Asia/Tokyo" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "question", "expectedFacts", "forbiddenFacts", "shouldAnswer", "severity"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "expectedFacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "forbiddenFacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "shouldAnswer": { "type": "boolean" },
          "severity": { "enum": ["normal", "important", "critical"] },
          "referenceTime": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}

